# Template file for 'kf6-kdoctools6.24'
# group=kde-frameworks
pkgname=kf6-kdoctools6.24
version=6.24.0
revision=1
build_style=cmake
build_helper=qemu
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 gettext perl perl-URI docbook-xml docbook-xsl"
makedepends="kf6-karchive6.24-devel kf6-ki18n6.24-devel libxslt-devel"
depends="docbook-xml docbook-xsl"
short_desc="KDE Create documentation from DocBook (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kdoctools"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=aee351c52f783813c6c114ade520c8578c570ee6dc25ecbd64c83e3d2d9660d4
conflicts="kf6-kdoctools"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

post_patch() {
	vsed -i -e '
		s;[$]{CMAKE_INSTALL_DATAROOTDIR};usr/share;
		/find_path/s/$/ NO_CMAKE_FIND_ROOT_PATH/
	' cmake/FindDocBookXML4.cmake cmake/FindDocBookXSL.cmake
}

kf6-kdoctools6.24-devel_package() {
	conflicts="kf6-kdoctools-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		mkdir -p "${DESTDIR}/usr/lib/cmake/KF6DocTools"
		mv ${PKGDESTDIR}/usr/lib/cmake/KF6DocTools/KF6DocToolsTools* \
			"${DESTDIR}/usr/lib/cmake/KF6DocTools"
		vmove "usr/lib/*.so"
	}
}
