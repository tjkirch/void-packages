# Template file for 'kf6-kholidays6.24'
# group=kde-frameworks
pkgname=kf6-kholidays6.24
version=6.24.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 qt6-declarative-host-tools flex"
makedepends="qt6-declarative-devel"
short_desc="Library to assist determining when holidays occur (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kholidays"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=02bfbc33296fe86b364491f6d5cad9d83360bb4fdd2923386a325b309eac0b9b
conflicts="kf6-kholidays"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-kholidays6.24-devel_package() {
	conflicts="kf6-kholidays-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
