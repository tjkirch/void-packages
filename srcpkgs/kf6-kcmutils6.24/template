# Template file for 'kf6-kcmutils6.24'
# group=kde-frameworks
pkgname=kf6-kcmutils6.24
version=6.24.0
revision=1
build_style=cmake
build_helper=qemu
configure_args="
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml"
hostmakedepends="extra-cmake-modules6.24 gettext qt6-tools qt6-base
 qt6-declarative-host-tools kf6-kconfig6.24"
makedepends="kf6-kconfigwidgets6.24-devel kf6-kcoreaddons6.24-devel kf6-kio6.24-devel
 kf6-kxmlgui6.24-devel kf6-kconfig6.24-devel qt6-declarative-devel kf6-kirigami6.24-devel"
checkdepends="kf6-kirigami6.24"
short_desc="Utilities for interacting with KCModules (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kcmutils"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=893346002b53a11bc9dd4053ad3d987d2545fac94fe38770f5d440343ee8e58a
conflicts="kf6-kcmutils"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-kcmutils6.24-devel_package() {
	conflicts="kf6-kcmutils-devel"
	depends="${sourcepkg}>=${version}_${revision}
	 kf6-kconfigwidgets6.24-devel kf6-kcoreaddons6.24-devel
	 qt6-declarative-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		mkdir -p "${DESTDIR}/usr/lib/cmake/KF6KCMUtils"
		mv ${PKGDESTDIR}/usr/lib/cmake/KF6KCMUtils/KF6KCMUtilsTool* \
			"${DESTDIR}/usr/lib/cmake/KF6KCMUtils/"
		vmove "usr/lib/*.so"
	}
}
