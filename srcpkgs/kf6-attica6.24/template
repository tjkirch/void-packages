# Template file for 'kf6-attica6.24'
# group=kde-frameworks
pkgname=kf6-attica6.24
version=6.24.0
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base"
makedepends="qt6-base-devel"
short_desc="Qt library that implements the Open Collaboration Services API (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/attica"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=67ea77148fba093bfdbd9104e3f09b995aefc34b0b6c34bc31a96e63b110abcb
conflicts="kf6-attica"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	ctest -E "providertest"
}

kf6-attica6.24-devel_package() {
	conflicts="kf6-attica-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
