conflicts="kmbox"

kmbox25.12-devel_package() {
	conflicts="kmbox-devel"
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
