kf6-kirigami6.24-devel_package() {
	conflicts="kf6-kirigami-devel"
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 qt6-declarative-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
