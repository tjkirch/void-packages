# Template file for 'kf6-kjobwidgets6.24'
# group=kde-frameworks
pkgname=kf6-kjobwidgets6.24
version=6.24.0
revision=1
build_style=cmake
_llvmver=21
configure_args="$(vopt_bool python BUILD_PYTHON_BINDINGS)"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 $(vopt_if python "python3-build python3-setuptools shiboken6 llvm${_llvmver}")"
makedepends="kf6-kcoreaddons6.24-devel kf6-knotifications6.24-devel
 kf6-kwidgetsaddons6.24-devel qt6-base-private-devel
 $(vopt_if python 'libshiboken6-devel libpyside6-devel python3-devel')"
short_desc="Widgets for showing progress of asynchronous jobs (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kjobwidgets"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=b3c5f449bf29b98394157656600e87b91f769afc5f547cef526faddb454f9b61
conflicts="kf6-kjobwidgets"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

build_options="python"
build_options_default="python"

if [ "$CROSS_BUILD" ]; then
	configure_args+=" -DECM_SHIBOKEN_ARCH=$XBPS_CROSS_RUST_TARGET"
	configure_args+=" -DSYSROOT_INCLUDE_DIRS=$XBPS_CROSS_BASE/usr/include"
fi
export LLVM_INSTALL_DIR=/usr/lib/llvm/${_llvmver}

case "$XBPS_TARGET_MACHINE" in
	arm*) configure_args+=" -DSHIBOKEN_GENERATOR_EXTRA_FLAGS=--clang-option=-mfloat-abi=hard" ;;
esac

kf6-kjobwidgets6.24-devel_package() {
	conflicts="kf6-kjobwidgets-devel"
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 kf6-kcoreaddons6.24-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
