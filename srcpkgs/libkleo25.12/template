conflicts="libkleo"

do_check() {
	cd build
	ctest -E 'newkeyapprovaldialogtest'
}

libkleo-devel_package() {
	conflicts="libkleo-devel"
	depends="${sourcepkg}>=${version}_${revision}
	 gpgmepp-devel gpgme-qt6-devel kf6-kconfig6.24-devel qt6-base-devel
	 kf6-kitemmodels6.24-devel kf6-kwidgetsaddons6.24-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
