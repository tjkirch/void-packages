configure_args="-DBUILD_TESTING=OFF
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-base python3 kf6-kconfig6.24
 gettext kf6-kcoreaddons6.24 kf6-kdoctools6.24"
makedepends="kf6-kio6.24-devel qtkeychain-qt6-devel kf6-kdoctools6.24-devel"
