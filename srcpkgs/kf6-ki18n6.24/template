# Template file for 'kf6-ki18n6.24'
# group=kde-frameworks
pkgname=kf6-ki18n6.24
version=6.24.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 qt6-declarative-host-tools gettext python3"
makedepends="qt6-declarative-devel"
depends="iso-codes"
short_desc="KDE Gettext-based UI text internationalization (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/ki18n"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=7424b61c152764c84d4dbba51ad960a9d7894e6909ecfaaa13e7b129585c0b57
conflicts="kf6-ki18n"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	# disable failing tests
	ctest -E "kcountrytest|kcountrysubdivisiontest|ki18n-klocalizedstringtest|kcatalogtest"
}

kf6-ki18n6.24-devel_package() {
	conflicts="kf6-ki18n-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
