# Template file for 'kf6-kpeople6.24'
# group=kde-frameworks
pkgname=kf6-kpeople6.24
version=6.24.1
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 kf6-kconfig6.24 qt6-declarative-host-tools gettext"
makedepends="kf6-kcontacts6.24-devel kf6-kcoreaddons6.24-devel kf6-ki18n6.24-devel
 kf6-kwidgetsaddons6.24-devel kf6-kitemviews6.24-devel"
short_desc="Library that provides access to all contacts and people who hold them (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kpeople"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.0}/${_distname}-${version}.tar.xz"
checksum=b03c2787c482179f83777aff3767b6835168b9934c8a4dca075e4f134ec62f50
conflicts="kf6-kpeople"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	# disable failing test
	ctest -E "personsmodeltest"
}

kf6-kpeople6.24-devel_package() {
	conflicts="kf6-kpeople-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
