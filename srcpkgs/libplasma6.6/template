 kf6-kpackage6.24"
makedepends="qt6-base-private-devel qt6-declarative-devel qt6-svg-devel
 kf6-kcmutils6.24-devel kf6-ksvg6.24-devel kf6-ki18n6.24-devel kf6-kwindowsystem6.24-devel
 kf6-kpackage6.24-devel kf6-kiconthemes6.24-devel kf6-kguiaddons6.24-devel kf6-karchive6.24-devel
