do_check() {
	cd build
	# disable failing tests
	ctest -E "plasma-dialogstatetest|dialognativetest|plasma-dialogqmltest|plasma-themetest|bug485688test|plasma-pluginloadertest"
}

libplasma6.6-devel_package() {
	conflicts="libplasma-devel"
	depends="${sourcepkg}>=${version}_${revision} qt6-declarative-devel
	 qt6-base-devel kf6-kpackage6.24-devel kf6-kwindowsystem6.24-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
