# Template file for 'kf6-kpackage6.24'
# group=kde-frameworks
pkgname=kf6-kpackage6.24
version=6.24.0
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base kf6-kdoctools6.24
 gettext"
makedepends="kf6-karchive6.24-devel kf6-kcoreaddons6.24-devel kf6-ki18n6.24-devel
 kf6-kdoctools6.24-devel"
short_desc="Aplications to manage user installable packages of non-binary assets (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kpackage"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=58939af0c553f24963652e10d248e2f8f2b2ca2b87dc26d3220675ed0cf33019
conflicts="kf6-kpackage"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

kf6-kpackage6.24-devel_package() {
	conflicts="kf6-kpackage-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		mkdir -p "${DESTDIR}/usr/lib/cmake/KF6Package"
		mv ${PKGDESTDIR}/usr/lib/cmake/KF6Package/KF6PackageTools* \
			"${DESTDIR}/usr/lib/cmake/KF6Package"
		vmove "usr/lib/*.so"
	}
}
