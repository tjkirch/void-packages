# Template file for 'kf6-kimageformats6.24'
# group=kde-frameworks
pkgname=kf6-kimageformats6.24
version=6.24.0
revision=2
build_style=cmake
configure_args="-DKIMAGEFORMATS_HEIF=ON -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 pkg-config"
makedepends="kf6-karchive6.24-devel libopenexr-devel libheif-devel libraw-devel
 libjxl-devel libavif-devel"
short_desc="KDE Plugins to allow QImage to support extra file formats (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kimageformats"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=7e9d35863e2227e37623f390f0e53a216931cd17920582cfc8282a42e04f16e2
conflicts="kf6-kimageformats"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	exclude="kimageformats-read-xcf|kimageformats-read-psd|kimageformats-read-hej2|kimageformats-write-hej2"
	case "$XBPS_TARGET_MACHINE" in
		i686*) exclude+="|kimageformats-write-exr";;
		*) ;;
	esac

	# disable failing tests
	ctest -E "$exclude"
}
