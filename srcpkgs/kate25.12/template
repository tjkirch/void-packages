 kf6-kconfig6.24 kf6-kdoctools6.24"
makedepends="kf6-kitemmodels6.24-devel kf6-knewstuff6.24-devel kf6-ktexteditor6.24-devel
 kf6-threadweaver6.24-devel kf6-kuserfeedback6.24-devel kf6-kdoctools6.24-devel
 kf6-ki18n6.24-devel kf6-kcoreaddons6.24-devel kf6-kguiaddons6.24-devel kf6-kcrash6.24-devel
 kf6-kiconthemes6.24-devel kf6-ktexteditor6.24-devel kf6-kdbusaddons6.24-devel
