# Template file for 'kf6-knotifications6.24'
# group=kde-frameworks
pkgname=kf6-knotifications6.24
version=6.24.0
revision=1
build_style=cmake
_llvmver=21
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 $(vopt_bool python BUILD_PYTHON_BINDINGS)"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 qt6-declarative-host-tools pkg-config kf6-kconfig6.24
 $(vopt_if python "python3-build python3-setuptools shiboken6 llvm${_llvmver}")"
makedepends="kf6-kconfig6.24-devel libcanberra-devel
 qt6-declarative-devel qt6-base-devel qt6-tools-devel
 $(vopt_if python 'libshiboken6-devel libpyside6-devel python3-devel')"
short_desc="KDE Desktop notifications (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/knotifications"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=12bb0b34ac9ae39b96d189cc0b29f526ae12a9014d0aad3721cacc9148e42940
conflicts="kf6-knotifications"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

build_options="python"
build_options_default="python"

if [ "$CROSS_BUILD" ]; then
	configure_args+=" -DECM_SHIBOKEN_ARCH=$XBPS_CROSS_RUST_TARGET"
	configure_args+=" -DSYSROOT_INCLUDE_DIRS=$XBPS_CROSS_BASE/usr/include"
fi
export LLVM_INSTALL_DIR=/usr/lib/llvm/${_llvmver}

case "$XBPS_TARGET_MACHINE" in
	arm*) configure_args+=" -DSHIBOKEN_GENERATOR_EXTRA_FLAGS=--clang-option=-mfloat-abi=hard" ;;
esac

kf6-knotifications6.24-devel_package() {
	conflicts="kf6-knotifications-devel"
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 libcanberra-devel kf6-kconfig6.24-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
