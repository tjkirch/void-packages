	broken="Qt6 WebEngine"
fi

do_check() {
	ctest -E "sieveeditorhelphtmlwidgettest"
}

libksieve25.12-devel_package() {
	conflicts="libksieve-devel"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
