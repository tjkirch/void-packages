# Template file for 'kf6-krunner6.24'
# group=kde-frameworks
pkgname=kf6-krunner6.24
version=6.30.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QTMETATYPESDIR=lib/qt6/metatypes"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 kf6-kconfig6.24 gettext"
makedepends="kf6-kconfig6.24-devel kf6-kcoreaddons6.24-devel kf6-ki18n6.24-devel
 kf6-kitemmodels6.24-devel kf6-kwindowsystem6.24-devel"
checkdepends="dbus"
short_desc="Framework for providing different actions given a string query"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/krunner"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=0885d0936aec6dc8553c673f1c685013e345b933a52812a07c5bddd1eebdb551
conflicts="kf6-krunner"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	dbus-run-session ctest
}

kf6-krunner-devel_package() {
	conflicts="kf6-krunner-devel"
	depends="${makedepends//private-} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
