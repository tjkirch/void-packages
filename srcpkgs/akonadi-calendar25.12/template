# Template file for 'akonadi-calendar25.12'
# group=kde-gear
pkgname=akonadi-calendar25.12
version=25.12.3
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules
 $(vopt_bool python BUILD_PYTHON_BINDINGS)"
hostmakedepends="extra-cmake-modules6.24 python3 qt6-base gettext
 kf6-kcoreaddons6.24 kf6-kconfig6.24
 $(vopt_if python "python3-build python3-setuptools shiboken6 llvm${_llvmver}")"
makedepends="kf6-kconfig6.24-devel kmime25.12-devel kf6-kcodecs6.24-devel kf6-ki18n6.24-devel
 kf6-kwidgetsaddons6.24-devel kf6-kxmlgui6.24-devel kf6-kio6.24-devel kf6-kdbusaddons6.24-devel
 kf6-kcalendarcore6.24-devel kf6-knotifications6.24-devel kmailtransport25.12-devel
 kidentitymanagement25.12-devel kcalutils25.12-devel messagelib25.12-devel kf6-kcrash6.24-devel
 $(vopt_if python 'libshiboken6-devel libpyside6-devel python3-devel')"
short_desc="Akonadi calendar integration (25.12 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://community.kde.org/KDE_PIM"
distfiles="${KDE_SITE}/release-service/${version}/src/akonadi-calendar-${version}.tar.xz"
checksum=ac606d2210ba581167b0f17bc81dc60ed4c0de66daf9adcd55fce25c73c60014
conflicts="akonadi-calendar"

if [ "$XBPS_WORDSIZE$XBPS_WORDSIZE" != "64$XBPS_TARGET_WORDSIZE" ]; then
	broken="Qt6 WebEngine"
fi

build_options="python"
build_options_default="python"

if [ "$CROSS_BUILD" ]; then
	configure_args+=" -DECM_SHIBOKEN_ARCH=$XBPS_CROSS_RUST_TARGET"
	configure_args+=" -DSYSROOT_INCLUDE_DIRS=$XBPS_CROSS_BASE/usr/include"
fi
export LLVM_INSTALL_DIR=/usr/lib/llvm/${_llvmver}

case "$XBPS_TARGET_MACHINE" in
	arm*) configure_args+=" -DSHIBOKEN_GENERATOR_EXTRA_FLAGS=--clang-option=-mfloat-abi=hard" ;;
esac


do_check() {
	cd build
	ctest -E 'kcalcoreserializertest'
}

akonadi-calendar25.12-devel_package() {
	conflicts="akonadi-calendar-devel"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
