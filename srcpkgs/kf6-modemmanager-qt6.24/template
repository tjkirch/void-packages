# Template file for 'kf6-modemmanager-qt6.24'
# group=kde-frameworks
pkgname=kf6-modemmanager-qt6.24
version=6.24.1
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 pkg-config"
makedepends="qt6-base-devel ModemManager-devel"
checkdepends="dbus"
short_desc="Qt wrapper for ModemManager DBus API (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/modemmanager-qt"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.0}/${_distname}-${version}.tar.xz"
checksum=69a281cd079f3782c689c31942d547359d36005b1d6dd69fc8fc1ccf1feadf12
conflicts="kf6-modemmanager-qt"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	dbus-run-session ctest
}

kf6-modemmanager-qt6.24-devel_package() {
	conflicts="kf6-modemmanager-qt-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
