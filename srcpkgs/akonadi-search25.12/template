hostmakedepends="extra-cmake-modules6.24 qt6-base qt6-tools python3 AppStream
 gettext kf6-kcoreaddons6.24 kf6-kpackage6.24 corrosion cargo kf6-kconfig6.24 kf6-kcmutils6.24"
makedepends="kf6-akonadi25.12-devel akonadi-mime25.12-devel xapian-core-devel rust-std
 ktextaddons-devel kf6-krunner6.24-devel
