	 kf6-kcolorscheme6.24-devel kf6-kiconthemes6.24-devel
	 kf6-kwidgetsaddons6.24-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
