kworkspace_package() {
	short_desc="Plasma Workspace Library for KF6"
	pkg_install() {
		vmove "usr/lib/libkworkspace6.so.6*"
	}
}

plasma-workspace-x11_package() {
	short_desc+=" - X11 Session"
	depends="${sourcepkg} kwin-x11-6.6"
	pkg_install() {
		vmove usr/bin/startplasma-x11
		vmove usr/share/xsessions/plasmax11.desktop
	}
}

plasma-workspace-devel_package() {
	conflicts="plasma-workspace-devel"
	short_desc+=" - development files"
	depends="kworkspace6.6>=${version}_${revision} qt6-base-devel
	 qt6-declarative-devel kf6-kitemmodels6.24-devel
	 ${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
	}
}
