do_check() {
	cd build
	ctest -E "mailserializerplugintest"
}

akonadi-mime25.12-devel_package() {
	conflicts="akonadi-mime-devel"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
