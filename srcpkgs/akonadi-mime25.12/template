 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules"
hostmakedepends="extra-cmake-modules6.24 kf6-kcoreaddons6.24 kf6-kdoctools6.24 python3
 shared-mime-info libxslt
 gettext qt6-base qt6-declarative-host-tools qt6-tools kf6-kconfig6.24"
makedepends="qt6-declarative-devel
 kf6-kio6.24-devel
 kf6-ki18n6.24-devel
 kf6-kxmlgui6.24-devel
 kf6-kitemmodels6.24-devel
 kmime25.12-devel kf6-akonadi25.12-devel kf6-kconfig6.24-devel kf6-kdoctools6.24-devel
 kf6-kcoreaddons6.24-devel"
short_desc="Libraries and daemons to implement basic email handling (25.12 series)"
