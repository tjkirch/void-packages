# Template file for 'kf6-kservice6.24'
# group=kde-frameworks
pkgname=kf6-kservice6.24
version=6.24.0
revision=1
build_style=cmake
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 gettext kf6-kdoctools6.24 kf6-kconfig6.24"
makedepends="kf6-kconfig6.24-devel kf6-kcoreaddons6.24-devel kf6-ki18n6.24-devel
 kf6-kdoctools6.24-devel"
short_desc="KDE Plugin framework for desktop services (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kservice"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=f7b3e5fab52949d16c0fce96afc5aaeb1cc94b47536e024d580750ffb1739723
conflicts="kf6-kservice"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	# tests fail on CI
	ctest -E "ksycocatest|kapplicationtradertest|kservicetest|ksycocathreadtest|ksycoca_xdgdirstest"
}

kf6-kservice6.24-devel_package() {
	conflicts="kf6-kservice-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
