do_check() {
	cd build
	# disable failing tests
	ctest -E "kstandardactiontest"
}

kf6-kconfigwidgets6.24-devel_package() {
	conflicts="kf6-kconfigwidgets-devel"
	depends="${sourcepkg}>=${version}_${revision} kf6-kcodecs6.24-devel
	 kf6-kconfig6.24-devel kf6-kwidgetsaddons6.24-devel kf6-kcolorscheme6.24-devel
	 qt6-base-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
