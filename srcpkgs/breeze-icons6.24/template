# Template file for 'breeze-icons6.24'
# group=kde-frameworks
pkgname=breeze-icons6.24
version=6.30.0
revision=1
build_style=cmake
configure_args="-DINSTALL_HOST_TOOLS=ON"
hostmakedepends="extra-cmake-modules6.24 qt6-base qt6-tools python3-lxml libxml2"
makedepends="qt6-base-devel"
checkdepends="fdupes"
short_desc="Breeze icon theme"
maintainer="John <me@johnnynator.dev>"
license="LGPL-3.0-or-later"
homepage="https://community.kde.org/Frameworks"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname}-${version}.tar.xz"
checksum=93866c19791838fc9757b305e010e23bb38cb5f201e4ecc96cc8ef5f1173ebe6
conflicts="breeze-icons"
nostrip=yes

if [ -z "$CROSS_BUILD" ]; then
	configure_args+=" -DBINARY_ICONS_RESOURCE=ON"
else
	hostmakedepends+=" libbreeze-icons6.24-devel"
	configure_args+=" -DBINARY_ICONS_RESOURCE=OFF"
fi

libbreeze-icons6.24_package() {
	conflicts="libbreeze-icons"
	pkg_install() {
		vmove "usr/lib/*.so.*"
	}
}

libbreeze-icons6.24-devel_package() {
	conflicts="libbreeze-icons-devel"
	depends="libbreeze-icons6.24>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		if [ -z "$CROSS_BUILD" ]; then
			vmove usr/bin
		fi
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
