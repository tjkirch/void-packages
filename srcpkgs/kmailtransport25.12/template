# Template file for 'kmailtransport25.12'
# group=kde-gear
pkgname=kmailtransport25.12
version=25.12.3
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules"
hostmakedepends="extra-cmake-modules6.24 qt6-base python3 gettext
 kf6-kcoreaddons6.24 kf6-kconfig6.24"
makedepends="kf6-kconfig6.24-devel kf6-kconfigwidgets6.24-devel kf6-kio6.24-devel libkgapi25.12-devel
 ksmtp25.12-devel qtkeychain-qt6-devel"
short_desc="Mail Transport Service (25.12 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://community.kde.org/KDE_PIM"
distfiles="${KDE_SITE}/release-service/${version}/src/kmailtransport-${version}.tar.xz"
checksum=f0c03316437f81f15a17ef31fe82884d816d2bace134a0aa45dc8bb0741eb501
conflicts="kmailtransport"

do_check() {
	cd build
	ctest -E '(smtpjob|akonadi-sqlite-attribute|akonadi-sqlite-messagequeuejob)test'
}

kmailtransport25.12-devel_package() {
	conflicts="kmailtransport-devel"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
