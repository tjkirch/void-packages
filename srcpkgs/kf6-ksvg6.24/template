 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 qt6-declarative-host-tools kf6-kconfig6.24"
makedepends="qt6-declarative-devel qt6-svg-devel kf6-karchive6.24-devel
 kf6-kconfig6.24-devel kf6-kcolorscheme6.24-devel kf6-kcoreaddons6.24-devel
 kf6-kirigami6.24-devel"
