configure_args="-DBUILD_DESIGNERPLUGIN=ON -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base"
makedepends="qt6-base-devel qt6-tools-devel"
short_desc="Set of item views extending the Qt model-view framework (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kitemviews"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.0}/${_distname}-${version}.tar.xz"
checksum=2b07af89d0229c7e2e8be830b67981b2bdca9072f18d6f5fa437b23e3ef4f22b
