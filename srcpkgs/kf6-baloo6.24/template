# Template file for 'kf6-baloo6.24'
# group=kde-frameworks
pkgname=kf6-baloo6.24
version=6.24.0
revision=1
build_style=cmake
configure_args="
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 qt6-declarative-host-tools gettext kf6-kconfig6.24-devel"
makedepends="qt6-declarative-devel kf6-kcoreaddons6.24-devel kf6-kconfig6.24-devel
 kf6-kdbusaddons6.24-devel kf6-ki18n6.24-devel kf6-kidletime6.24-devel kf6-solid6.24-devel
 kf6-kcrash6.24-devel kf6-kio6.24-devel kf6-kfilemetadata6.24-devel lmdb-devel"
short_desc="Framework for searching and managing metadata (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/baloo"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=1f72676817b9636b80c971934fb7f2c5d396da4758c33998abc4b9ae82195ce4
conflicts="kf6-baloo"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	# disable failing text
	ctest -E "(filemonitortest|filewatchtest)"
}

kf6-baloo6.24-devel_package() {
	conflicts="kf6-baloo-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
