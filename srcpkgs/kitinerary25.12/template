do_check() {
	cd build

	# extractortest is broken
	ctest -E extractortest
}

kitinerary25.12-devel_package() {
	conflicts="kitinerary-devel"
	depends="${makedepends} ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
