hostmakedepends="extra-cmake-modules6.24 gettext kf6-kcoreaddons6.24 pkg-config
 qt6-tools qt6-tools qt6-tools-devel kf6-kconfig6.24"
makedepends="kf6-kcalendarcore6.24-devel kf6-kcontacts6.24-devel kf6-kdeclarative6.24-devel
