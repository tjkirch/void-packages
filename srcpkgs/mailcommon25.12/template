# Template file for 'mailcommon25.12'
# group=kde-gear
pkgname=mailcommon25.12
version=25.12.3
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF
 -DOPTION_USE_PLASMA_ACTIVITIES=ON
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules"
hostmakedepends="extra-cmake-modules6.24 kf6-kconfig6.24 libxslt qt6-base qt6-tools
 gettext python3"
makedepends="mailimporter25.12-devel messagelib25.12-devel qt6-tools-devel
 plasma-activities6.6-devel
 pimcommon25.12-devel libkleo25.12-devel qt6-multimedia-devel phonon-devel kf6-kcontacts6.24-devel"
checkdepends="dbus"
short_desc="KDE PIM library providing support for mail applications (25.12 series)"
maintainer="Tom <void@halffull.org>"
license="GPL-2.0-or-later, LGPL-2.1-or-later"
homepage="https://community.kde.org/KDE_PIM"
distfiles="${KDE_SITE}/release-service/${version}/src/mailcommon-${version}.tar.xz"
checksum=055bbae0e0df9f0610fca2a4303fe6caabdfc206910a04832cbd717b3c1374e4
conflicts="mailcommon"

if [ "$XBPS_WORDSIZE$XBPS_WORDSIZE" != "64$XBPS_TARGET_WORDSIZE" ]; then
	broken="Qt6 WebEngine"
fi

do_check() {
	cd build
	broken="mailcommon-filter-filteractionencrypttest"
	broken+="|mailcommon-filter-filteractionmissingidentitydialogtest" # hangs
	dbus-run-session ctest -E "($broken)"
}

mailcommon25.12-devel_package() {
	conflicts="mailcommon-devel"
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel
	 kf6-akonadi25.12-devel libkdepim25.12-devel kmime25.12-devel kf6-kconfig6.24-devel
	 kf6-kio6.24-devel messagelib25.12-devel kf6-ki18n6.24-devel akonadi-mime25.12-devel
	 pimcommon25.12-devel kf6-kcompletion6.24-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
