# Template file for 'kf6-networkmanager-qt6.24'
# group=kde-frameworks
pkgname=kf6-networkmanager-qt6.24
version=6.24.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 pkg-config qt6-declarative-host-tools"
makedepends="qt6-declarative-devel NetworkManager-devel"
short_desc="Qt wrapper for NetworkManager API (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/networkmanager-qt"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=b9d44f80e054353f87b4274481b320676d95bd3835ffbbfdf19ef4f2a2ef0fff
conflicts="kf6-networkmanager-qt"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	# disable failing tests
	ctest -E "managertest|settingstest|activeconnectiontest"
}

kf6-networkmanager-qt6.24-devel_package() {
	conflicts="kf6-networkmanager-qt-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
