# Template file for 'kf6-kcontacts6.24'
# group=kde-frameworks
pkgname=kf6-kcontacts6.24
version=6.30.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 gettext qt6-declarative-host-tools kf6-kconfig6.24"
makedepends="qt6-base-devel kf6-kcoreaddons6.24-devel kf6-ki18n6.24-devel
 kf6-kconfig6.24-devel kf6-kcodecs6.24-devel"
short_desc="Library for working with contact information (6.24 series)"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kcontacts"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=170b51a41ac132968ea03d5f1ce8c585777155bbdc57e819a0562b1f8d03b7a5
conflicts="kf6-kcontacts"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

do_check() {
	cd build
	# disable failing test
	ctest -E "kcontacts-addresstest"
}

kf6-kcontacts6.24-devel_package() {
	conflicts="kf6-kcontacts-devel"
	depends="$makedepends ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
