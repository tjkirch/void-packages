# Template file for 'libkdepim25.12'
# group=kde-gear
pkgname=libkdepim25.12
version=25.12.3
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules"
hostmakedepends="extra-cmake-modules6.24 qt6-base qt6-tools gettext"
makedepends="kf6-kcompletion6.24-devel kf6-ki18n6.24-devel qt6-tools-devel"
short_desc="Libraries for KDE PIM applications (25.12 series)"
maintainer="Tom <void@halffull.org>"
license="GPL-2.0-or-later, LGPL-2.1-or-later"
homepage="https://community.kde.org/KDE_PIM"
distfiles="${KDE_SITE}/release-service/${version}/src/libkdepim-${version}.tar.xz"
checksum=5b2ffc63f30ffdf513061b634db3df6019ab4aad56b1c11f50dadec081b8cf43
conflicts="libkdepim"

if [ "$CROSS_BUILD" ]; then
	configure_args+=" -DDESKTOPTOJSON_EXECUTABLE=/usr/bin/desktoptojson"
fi

libkdepim25.12-devel_package() {
	conflicts="libkdepim-devel"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
