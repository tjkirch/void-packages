# Template file for 'kcalutils25.12'
# group=kde-gear
pkgname=kcalutils25.12
version=25.12.3
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins
 -DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DECM_MKSPECS_INSTALL_DIR=/usr/lib/qt6/mkspecs/modules"
hostmakedepends="extra-cmake-modules6.24 qt6-base qt6-tools python3
 gettext kf6-kcoreaddons6.24 kf6-kconfig6.24"
makedepends="kidentitymanagement25.12-devel kf6-ktexttemplate6.24-devel kf6-kcalendarcore6.24-devel"
short_desc="KDE calendar utility library (25.12 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.0-or-later"
homepage="https://community.kde.org/KDE_PIM"
distfiles="${KDE_SITE}/release-service/${version}/src/kcalutils-${version}.tar.xz"
checksum=8d54dfef43b7929c9d9b52ba2b6234f94537923e4ff94984611bf7489502a234
conflicts="kcalutils"

do_check() {
	cd build
	ctest -E 'kcalutils-testincidenceformatter'
}

kcalutils25.12-devel_package() {
	conflicts="kcalutils-devel"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
