# Template file for 'kf6-kauth6.24'
# group=kde-frameworks
pkgname=kf6-kauth6.24
version=6.30.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base"
makedepends="kf6-kcoreaddons6.24-devel kf6-kwindowsystem6.24-devel polkit-qt6-devel"
checkdepends="dbus"
short_desc="KDE Execute actions as privileged user"
maintainer="John <me@johnnynator.dev>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kauth"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${pkgname#kf6-}-${version}.tar.xz"
checksum=60b75e02abc2bfbb247c586e3ab94def7ecd7b4e1ddb8260358951d84d9ea8c9
conflicts="kf6-kauth"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"
subpackages="kf6-kauth-tools6.24 kf6-kauth6.24-devel"

do_check() {
	cd build
	dbus-run-session ctest
}

kf6-kauth-tools6.24_package() {
	short_desc+=" - tools"
	pkg_install() {
		vmove usr/libexec
		vmove "usr/lib/cmake/KF6Auth/*Tools*"
	}
}

kf6-kauth6.24-devel_package() {
	conflicts="kf6-kauth-devel"
	depends="$makedepends kf6-kauth-tools6.24>=${version}_${revision}
	 ${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
