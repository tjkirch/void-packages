# Template file for 'kf6-kwindowsystem6.24'
# group=kde-frameworks
pkgname=kf6-kwindowsystem6.24
version=6.24.0
revision=1
build_style=cmake
configure_args="-DKDE_INSTALL_QMLDIR=lib/qt6/qml
 -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins"
hostmakedepends="extra-cmake-modules6.24 qt6-tools qt6-base
 qt6-declarative-host-tools pkg-config wayland-devel"
makedepends="qt6-declarative-devel
 plasma-wayland-protocols wayland-devel qt6-base-private-devel"
short_desc="KDE frameworks - Access to the windowing system (6.24 series)"
maintainer="Tom <void@halffull.org>"
license="LGPL-2.1-or-later"
homepage="https://invent.kde.org/frameworks/kwindowsystem"
_distname="${pkgname#kf6-}"; _distname="${_distname%6.24}"
distfiles="${KDE_SITE}/frameworks/${version%.*}/${_distname}-${version}.tar.xz"
checksum=2291d95836e8b81263ceea0c1ffa7cfd92773130d6edd130b439874169f13e58
conflicts="kf6-kwindowsystem"

# stage builds
makedepends+=" kf6-base6.24"
shlib_requires="KDE_Frameworks.${version%.*}"

post_install() {
	sed -i -e 's:/usr/[a-z0-9-]*/usr/include;::' \
		${DESTDIR}/usr/lib/cmake/*/*Targets.cmake
}

do_check() {
	cd build
	# disable failing tests
	tests=("kwindowsystem-kmanagerselectiontest"
		"kwindowsystem-kstartupinfo_unittest"
		"kwindowsystem-kxmessages_unittest"
		"kwindowsystem-kkeyserver_x11_unittest"
		"kwindowsystem-kwindoweffectstest"
		"kwindowsystem-kwindowinfox11test"
		"kwindowsystem-kwindowsystemx11test"
		"kwindowsystem-kwindowsystem_threadtest"
		"kwindowsystem-netrootinfotestwm"
		"kwindowsystem-netwininfotestclient"
		"kwindowsystem-netwininfotestwm"
		"kwindowsystem-kmanagerselectiontest"
		"kwindowsystem-compositingenabled_test"
		"kwindowsystem-compositingenabled_test")
	ctest -E "($( echo ${tests[@]} | tr " " "|" ))"
}

kf6-kwindowsystem6.24-devel_package() {
	conflicts="kf6-kwindowsystem-devel"
	depends="${sourcepkg}>=${version}_${revision} qt6-base-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/lib/pkgconfig
		vmove usr/include
		vmove usr/lib/cmake
		vmove "usr/lib/*.so"
	}
}
